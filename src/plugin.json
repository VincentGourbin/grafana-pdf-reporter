{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "PDF Reporter",
  "id": "vincentgourbin-pdfreporter-app",
  "info": {
    "description": "Export Grafana dashboards to PDF with cover page.",
    "author": {
      "name": "Vincent Gourbin",
      "url": "https://github.com/VincentGourbin"
    },
    "links": [
      {
        "name": "Repository",
        "url": "https://github.com/VincentGourbin/grafana-pdf-reporter"
      },
      {
        "name": "Issues",
        "url": "https://github.com/VincentGourbin/grafana-pdf-reporter/issues"
      },
      {
        "name": "License",
        "url": "https://github.com/VincentGourbin/grafana-pdf-reporter/blob/main/LICENSE"
      }
    ],
    "keywords": ["pdf", "report", "export", "dashboard"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Dashboard selection",
        "path": "img/screenshots/dashboard-selection.png"
      },
      {
        "name": "Cover settings and preview",
        "path": "img/screenshots/cover-settings.png"
      },
      {
        "name": "Generated PDF",
        "path": "img/screenshots/generated-pdf.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.4.0",
    "plugins": []
  },
  "includes": [
    {
      "type": "page",
      "name": "PDF Reporter",
      "path": "/a/vincentgourbin-pdfreporter-app",
      "role": "Viewer",
      "addToNav": true,
      "defaultNav": true
    }
  ],
  "extensions": {
    "addedLinks": [
      {
        "title": "Export PDF",
        "description": "Open the PDF Reporter page",
        "targets": ["grafana/megamenu/action"]
      },
      {
        "title": "Export PDF",
        "description": "Generate a PDF report of the current dashboard",
        "targets": ["grafana/commandpalette/action"]
      }
    ]
  },
  "backend": true,
  "executable": "gpx_pdfreporter",
  "preload": true
}
